# ---- Server ----
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ---- Database ----
# Managed Postgres connection string (Neon / Supabase / Railway). TLS is always
# used, so the DB must support SSL (all managed providers do).
# Example: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ---- Provider (real credentials live ONLY here, server-side) ----
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
# Upstream request timeout in milliseconds before we retry / fall back.
PROVIDER_TIMEOUT_MS=20000
# How many times to try the caller's chosen model before falling back to mock.
PROVIDER_MAX_ATTEMPTS=2

# ---- Admin ----
# Bearer token required to mint virtual keys via POST /admin/keys.
ADMIN_TOKEN=change-me-to-a-long-random-string
